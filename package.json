{
  "name": "baekho-enemy-forge",
  "version": "1.2.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Studio Baekho — Unity enemy prefab authoring desktop app",
  "author": "Studio Baekho",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:unity": "tsx scripts/smoke-unity.ts",
    "test:boss": "tsx scripts/smoke-boss.ts --play",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.studiobaekho.enemyforge",
    "productName": "Baekho Enemy Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "unity-integration",
        "to": "unity-integration"
      },
      {
        "from": "README.md",
        "to": "README.ko.md"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Baekho-Enemy-Forge-${version}-Windows.exe"
    }
  }
}
